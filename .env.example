# Google Analytics 4 — used in gtag.js via layout.tsx
# NEXT_PUBLIC_GA_ID=G-44MNCME40P

# Server-only — never expose to client
HUBSPOT_EMPLOYER_WEBHOOK_URL=https://your-webhook-endpoint/va-intake
HUBSPOT_WEBHOOK_SECRET=your-shared-secret-here

# Supabase (project: vyyzydhqnnssfvkefeot)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Discord
DISCORD_WEBHOOK_OPS=https://discord.com/api/webhooks/...

# Atlas CRM ingestion — server-only, never expose to client.
# Host is not finalized; set the full endpoint path here.
CRM_INGESTION_ENDPOINT=https://your-crm-host/api/v1/integrations/global-assist
HOLDINGS_INGESTION_SECRET=shared-hmac-signing-secret

# Atlas Fleet Ticketing Bridge intake — server-only, never expose to client.
# Used by /api/hire to file one unclaimed intake row per employer lead
# (tantaglobal.com/hire → tantaglobal.com/api/hire). The intake route can
# only create; lifecycle (claim/transition/release) is Raphael-only.
ATLAS_FLEET_TICKETING_BRIDGE_URL=
ATLAS_FLEET_TICKETING_BRIDGE_SECRET=
